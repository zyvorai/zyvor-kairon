[Unit]
Description=kairon - watch kubelet cpu_manager_state for kairon-node
Documentation=https://github.com/zyvorai/zyvor-kairon

[Path]
PathChanged=/var/lib/kubelet/cpu_manager_state
Unit=kairon-cpustate.service

[Install]
WantedBy=multi-user.target
