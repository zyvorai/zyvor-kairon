      "id": 9,
      "type": "timeseries",
      "title": "Quota used / hard",
      "description": "kairon_quota_resource. Alert: KaironQuotaNearLimit (>=0.9 for 10m). Only dimensions with a hard cap have a series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
