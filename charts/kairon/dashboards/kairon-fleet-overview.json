      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, quota, resource) (kairon_quota_resource{type=\"used\"}) / max by (namespace, quota, resource) (kairon_quota_resource{type=\"hard\"})",
          "legendFormat": "{{namespace}}/{{quota}} {{resource}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
