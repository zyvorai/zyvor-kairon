      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (increase(kairon_apiserver_request_duration_seconds_count{outcome=\"error\"}[15m]))",
          "legendFormat": "{{job}}"
        }
